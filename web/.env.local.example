# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
# Supabase Dashboard -> Project Settings -> API
#
# ⚠️ ใช้ anon key เท่านั้น ห้ามใส่ service_role key ที่นี่เด็ดขาด
#    ตัวแปรที่ขึ้นต้น NEXT_PUBLIC_ จะไปอยู่ใน bundle ที่ใครก็เปิดดูได้ (ดู doc/TRAPS.md)

NEXT_PUBLIC_SUPABASE_URL=https://minfibikrogtptozszxv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Gemini (ประตูที่สาม · แชตและเสียง) ----
# ขอคีย์ที่ https://aistudio.google.com/apikey
#
# ⚠️ ห้ามมี NEXT_PUBLIC_ นำหน้าเด็ดขาด — คีย์นี้ต้องอยู่ฝั่งเซิร์ฟเวอร์เท่านั้น
#    ถ้าหลุดลง bundle ใครก็เอาไปใช้จนโควตาหมดหรือบิลบานได้ (doc/TRAPS.md)
GEMINI_API_KEY=

# ชื่อรุ่นแยกกันสองช่องทางเพื่อให้ **โควตาแยกกัน** (doc/CHAT.md §4)
# เว้นว่างได้ ใช้ค่าตั้งต้นในโค้ด
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
